<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ExitGuard · Panel de ingresos</title>
<style>
  :root{
    --bg:#07090d;--panel:#11161f;--ink:#e9f0f5;--muted:#7d8b98;--line:#1e2733;
    --green:#2ecc71;--cy:#33c2cf;--amber:#e0a53a;--dim:#3a4652;
    --mono:ui-monospace,"Cascadia Code","SF Mono",Menlo,Consolas,monospace;
    --sans:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);
    background-image:radial-gradient(circle at 50% 0%,rgba(51,194,207,.06),transparent 60%)}
  .wrap{max-width:840px;margin:0 auto;padding:32px 20px 60px}
  .top{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
  .brand{font-size:20px;font-weight:700;letter-spacing:-.01em}
  .brand small{color:var(--muted);font-weight:400;font-size:13px}
  .status{font-family:var(--mono);font-size:12px;display:flex;align-items:center;gap:8px;color:var(--muted)}
  .pulse{width:9px;height:9px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 rgba(46,204,113,.6);animation:p 2s infinite}
  .pulse.off{background:var(--dim);animation:none;box-shadow:none}
  @keyframes p{0%{box-shadow:0 0 0 0 rgba(46,204,113,.5)}70%{box-shadow:0 0 0 10px rgba(46,204,113,0)}100%{box-shadow:0 0 0 0 rgba(46,204,113,0)}}
  .hero{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:38px 28px;margin:22px 0;text-align:center;position:relative;overflow:hidden}
  .hero .lbl{font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.16em;color:var(--muted)}
  .hero .bal{font-family:var(--mono);font-size:clamp(48px,13vw,86px);font-weight:800;line-height:1;margin:14px 0 6px;font-variant-numeric:tabular-nums;color:var(--green)}
  .hero .bal.zero{color:var(--dim)}
  .hero .wallet{font-family:var(--mono);font-size:12px;color:var(--muted);word-break:break-all}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}
  .kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px 20px}
  .kpi .k{font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}
  .kpi .v{font-family:var(--mono);font-size:30px;font-weight:700;margin-top:8px;font-variant-numeric:tabular-nums}
  .kpi .v.cy{color:var(--cy)} .kpi .v.am{color:var(--amber)}
  .note{margin-top:22px;background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--amber);border-radius:0 12px 12px 0;padding:14px 18px;font-size:13.5px;color:var(--muted);line-height:1.6}
  .note b{color:var(--ink)}
  .ticker{margin-top:16px;font-family:var(--mono);font-size:12px;color:var(--muted);text-align:center}
  a{color:var(--cy)}
  .flash{animation:fl 1.2s ease}
  @keyframes fl{0%{background:rgba(46,204,113,.25)}100%{background:transparent}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div class="brand">ExitGuard <small>· panel de ingresos</small></div>
    <div class="status"><span class="pulse" id="pulse"></span><span id="statusTxt">conectando…</span></div>
  </div>

  <div class="hero" id="hero">
    <div class="lbl">USDC en tu wallet (Base · en vivo desde la cadena)</div>
    <div class="bal zero" id="bal">$0.000000</div>
    <div class="wallet" id="wallet">—</div>
  </div>

  <div class="grid">
    <div class="kpi"><div class="k">Llamadas pagas</div><div class="v cy" id="paid">0</div></div>
    <div class="kpi"><div class="k">Ingreso estimado</div><div class="v" id="rev">$0.00</div></div>
    <div class="kpi"><div class="k">Requests totales</div><div class="v" id="reqs">0</div></div>
    <div class="kpi"><div class="k">Red</div><div class="v am" id="net" style="font-size:20px">—</div></div>
  </div>

  <div class="note" id="note">
    Este panel lee tu <b>saldo real de USDC en Base</b> directo de la blockchain. Muestra
    <b>$0 hasta que un agente pague</b> — no es un error, es la verdad: el servicio está vivo y listo,
    falta la demanda. En <b>testnet</b> los pagos son de prueba; con tus claves CDP salta a
    <b>mainnet</b> y el número de arriba es dinero real.
  </div>
  <div class="ticker" id="ticker">actualiza cada 15s · última: —</div>
</div>

<script>
// intenta el túnel público primero, luego localhost
const ENDPOINTS = [
  "https://upc-travelers-hull-veterinary.trycloudflare.com/stats",
  "http://localhost:8402/stats"
];
let lastPaid = 0, lastBal = 0;

function fmt(n, d=6){ return "$" + (Number(n)||0).toLocaleString("en-US",{minimumFractionDigits:d,maximumFractionDigits:d}); }

async function tick(){
  let s = null;
  for(const u of ENDPOINTS){
    try{ const r = await fetch(u,{cache:"no-store"}); if(r.ok){ s = await r.json(); break; } }catch(e){}
  }
  const pulse=document.getElementById("pulse"), st=document.getElementById("statusTxt");
  if(!s){ pulse.className="pulse off"; st.textContent="servicio offline"; return; }
  pulse.className="pulse"; st.textContent="en vivo · "+(s.uptime_min||0)+" min activo";

  const bal=Number(s.usdc_balance)||0;
  const be=document.getElementById("bal");
  be.textContent=fmt(bal); be.className="bal"+(bal>0?"":" zero");
  document.getElementById("wallet").textContent=s.wallet||"—";
  document.getElementById("paid").textContent=s.paid||0;
  document.getElementById("rev").textContent="$"+((s.revenue_est_usd)||0).toFixed(2);
  document.getElementById("reqs").textContent=s.requests||0;
  document.getElementById("net").textContent=s.network==="base"?"MAINNET":"testnet";

  // destello cuando entra un pago nuevo o sube el saldo
  if((s.paid>lastPaid)||(bal>lastBal)){ document.getElementById("hero").classList.remove("flash"); void document.getElementById("hero").offsetWidth; document.getElementById("hero").classList.add("flash"); }
  lastPaid=s.paid||0; lastBal=bal;
  document.getElementById("ticker").textContent="actualiza cada 15s · última: "+new Date().toLocaleTimeString();
}
tick(); setInterval(tick, 15000);
</script>
</body>
</html>
